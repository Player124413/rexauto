 static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
-  REXLOG_ERROR("Call to unresolved function at guest address 0x{:08X} (returning)",
-              ctx.last_indirect_target);
-  // Return instead of crashing. Many indirect call targets are runtime-computed
-  // vtable entries that static analysis cannot discover. Returning is safer
-  // than crashing and lets the game continue past non-critical callbacks.
+  const uint32_t target = ctx.last_indirect_target;
+  // Tolerant mode (REX_HEAL_DISCOVER, the launcher's "tolerant" switch): log
+  // each unresolved target once and return -- many are runtime-computed vtable
+  // entries static analysis could not see, and a target of 0 is the title
+  // calling through a pointer it never filled in. Otherwise abort loudly, so a
+  // real missing function is visible instead of silently corrupting state.
+  static const bool tolerant = std::getenv("REX_HEAL_DISCOVER") != nullptr;
+  if (tolerant) {
+    static std::mutex mtx;
+    static std::unordered_set<uint32_t> seen;
+    std::lock_guard<std::mutex> lk(mtx);
+    if (seen.insert(target).second) {
+      REXLOG_WARN("Call to invalid or unregistered function at guest address 0x{:08X} (returning)",
+                  target);
+    }
+    return;
+  }
+  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X} "
+            "(called from lr=0x{:08X})",
+            target, static_cast<uint32_t>(ctx.lr));
 }
 
